[Unit]
Description=myh Platform Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/myh-platform-watchdog.sh
EnvironmentFile=-/etc/hosting-panel.env
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /var/lib/myh-notifications
